{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Moalem",
  "version": "0.1.0",
  "identifier": "ir.amoozgar.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "وب آموزگار | دستیار هوشمند معلم",
        "width": 1360,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["Persian", "English"],
        "displayLanguageSelector": true
      }
    }
  }
}
