@echo off
chcp 65001 > nul
title دفتریار معلمان - اجرای برنامه

echo ===================================================
echo    درحال راه اندازی برنامه مدیریت کلاس و معلم...
echo ===================================================
echo.

:: ۱. بررسی نصب بودن Node.js
where node >nul 2>nul
if %errorlevel% neq 0 (
    echo [خطا] نرم افزار Node.js روی کامپیوتر شما نصب نیست!
    echo برای اجرای برنامه، ابتدا باید Node.js را دانلود و نصب کنید:
    echo https://nodejs.org
    echo.
    pause
    exit /b
)

:: ۲. بررسی وجود فایل اصلی پروژه
if not exist "package.json" (
    echo [خطا] فایل Run_App.bat خارج از پوشه اصلی برنامه قرار دارد!
    echo لطفاً این فایل را حتماً داخل پوشه اصلی استخراج شده پروژه بگذارید و اجرا کنید.
    echo.
    pause
    exit /b
)

:: ۳. بررسی کامل بودن پکیج ها (بررسی مستقیم کتابخانه vite)
if not exist "node_modules\vite\" (
    echo [اطلاع] کتابخانه ها و پیش نیازهای برنامه هنوز نصب نشده اند.
    echo درحال دانلود و نصب خودکار پیش نیازها (فقط بار اول ممکن است ۲ تا ۳ دقیقه زمان ببرد)...
    echo لطفاً تا پایان نصب صبر کنید و این پنجره را نبندید.
    echo.
    call npm install
    if %errorlevel% neq 0 (
        echo.
        echo [خطا] دانلود پیش نیازها با خطا مواجه شد!
        echo لطفاً اتصال اینترنت خود را بررسی کنید و دوباره Run_App.bat را اجرا کنید.
        echo.
        pause
        exit /b
    )
    echo.
    echo [موفقیت] نصب پیش نیازها با موفقیت به پایان رسید!
    echo.
)

:: ۴. باز کردن مرورگر و اجرای سرور
echo درحال باز کردن مرورگر وب...
start "" "http://localhost:3000"

echo [موفقیت] برنامه در حال اجراست... (این پنجره را نبندید)
echo.
call npm run dev

pause
